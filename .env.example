# Скопируй этот файл в .env и заполни значения

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Google Apps Script web app URL for feedback collection (optional)
# The script should append a row: [timestamp, app, email, message]
# Deploy → New deployment → Web app → Execute as: Me, Who has access: Anyone
VITE_FEEDBACK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
